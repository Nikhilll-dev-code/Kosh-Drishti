# ============================================================
# KOSH-DRISHTI — BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# Port the Express backend listens on
PORT=5000

# Application environment
NODE_ENV=development

# Secret key used to sign JWT tokens.
# Use a long, random string in production.
JWT_SECRET=your_jwt_secret_here

# Groq API key for LLM-assisted explanation (Llama 3.3 70B).
# Get a free key at https://console.groq.com
# If left empty, the system uses a deterministic template fallback.
GROQ_API_KEY=your_groq_api_key_here

# URL of the Python FastAPI ML microservice
ML_SERVICE_URL=http://localhost:8000
