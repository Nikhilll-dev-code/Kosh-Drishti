# ============================================================
# KOSH-DRISHTI — ML SERVICE ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# Groq API key for LLM-assisted explanation (Python explainer).
# Get a free key at https://console.groq.com
# If left empty, the Python explainer uses a template fallback.
GROQ_API_KEY=your_groq_api_key_here

# Port the FastAPI ML service listens on
PORT=8000
