# ============================================================
# KOSH-DRISHTI — .gitignore
# ============================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.*
!.env.example

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Frontend Build Output ---
frontend/dist/
frontend/build/

# --- Python ---
ml_service/venv/
ml_service/.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/

# --- Logs ---
logs/
*.log

# --- OS & Editor Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Coverage & Testing Artifacts ---
coverage/
.nyc_output/
htmlcov/

# --- Temporary & Cache ---
.cache/
.temp/
tmp/

# --- Database Runtime File ---
# The seed data will regenerate db.json on first startup.
# Do NOT ignore the seed scripts or CSV source data.
backend/data/db.json
