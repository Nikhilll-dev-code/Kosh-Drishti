# ============================================================
# KOSH-DRISHTI — FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in values for production deployment.
# In local development, leave empty or set to empty string to use Vite proxy.
# ============================================================

# Base API URL for backend calls.
# Local development: leave empty (defaults to relative /api paths proxied by Vite)
# Production example: https://kosh-drishti-backend.onrender.com
VITE_API_URL=
